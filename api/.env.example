# Copia este archivo como .env y cambia los valores. Nunca subas el .env al repositorio.

# --- Seguridad / JWT ---
# Clave para firmar los tokens y los hash de los códigos. Larga y aleatoria (32+ caracteres).
SECRET_KEY=pon_aqui_una_clave_larga_y_secreta_de_32_o_mas_caracteres
# Horas que dura un token de sesión
JWT_HORAS=24

# --- Firebase ---
# Ruta al JSON de la cuenta de servicio (relativa a la carpeta desde donde corres la API)
FIREBASE_CREDENCIALES=serviceAccountKey.json
# Nombre del bucket de Storage, sin gs://
FIREBASE_BUCKET=tu-proyecto.firebasestorage.app
# Clave de API web (Configuración del proyecto > General). La usa el login con correo y clave
FIREBASE_WEB_API_KEY=pega_aqui_la_clave_de_api_web

# --- Web ---
# Origen permitido por CORS: * o una sola URL, p. ej. http://localhost:5173
CORS_ORIGENES=*
# URL de la web (botón "Empezar a escuchar" del correo de bienvenida)
WEB_URL=http://localhost:5173

# --- Correos ---
NOMBRE_APP=APIMusic
# URL pública de un PNG (opcional). Vacía = círculo verde con una nota musical
LOGO_URL=
# Deja SMTP_HOST vacío para que los códigos se impriman en la consola de la API
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS, 465 = SSL
SMTP_PUERTO=587
SMTP_USUARIO=tucorreo@gmail.com
# En Gmail: contraseña de aplicación de 16 letras (no tu contraseña normal)
SMTP_CLAVE=xxxx xxxx xxxx xxxx
# Remitente visible; si está vacío se usa SMTP_USUARIO
CORREO_REMITENTE=tucorreo@gmail.com
